# Copy to .env and fill in. Every key here is declared in app/config.py.

SECRET_KEY=
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
EXTRA_CORS_ORIGINS=
DATABASE_URL=postgresql+asyncpg://nablon:secret@localhost:5432/nablon_careers
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=nabloncareers

DIRECTOR_EMAIL=
DIRECTOR_NAME=Director
HR_NOTIFICATION_EMAIL=hr@nablon.ai

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-01

MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_MAIL_SENDER=noreply@nablon.ai

AUTOPROCTOR_ENABLED=true
AUTOPROCTOR_LOGIN_EMAIL=
AUTOPROCTOR_OTP_SENDER=
AUTOPROCTOR_SYNC_START=2026-10-17

# ── Zoho Sign (offer letter e-signature) ─────────────────────────────────────
# While CLIENT_ID / CLIENT_SECRET / REFRESH_TOKEN are blank, offers keep the
# older in-portal director → candidate signing flow.
#
# 1. https://api-console.zoho.in → Add Client → Self Client → copy ID + secret.
# 2. Generate Code with scope: ZohoSign.documents.ALL,ZohoSign.account.READ
#    (duration 10 min), then exchange it once for a refresh token:
#    curl -X POST "https://accounts.zoho.in/oauth/v2/token?grant_type=authorization_code&client_id=<ID>&client_secret=<SECRET>&code=<CODE>"
# 3. Use the .com / .eu hosts below if the Zoho org is not on the India DC.
ZOHO_SIGN_CLIENT_ID=
ZOHO_SIGN_CLIENT_SECRET=
ZOHO_SIGN_REFRESH_TOKEN=
ZOHO_SIGN_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_SIGN_API_BASE=https://sign.zoho.in/api/v1
# Zoho Sign → Settings → Developer settings → Webhooks → Create.
# URL: https://<backend-host>/api/v1/esign/webhook/zoho, HMAC on, paste the same secret here.
ZOHO_SIGN_WEBHOOK_SECRET=
